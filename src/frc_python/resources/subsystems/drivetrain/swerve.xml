<mujoco model="mk5n_swerve">
  <compiler angle="radian" coordinate="local" />
  <option timestep="0.001" integrator="RK4" cone="elliptic" />

  <default>
    <default class="visual">
      <geom type="mesh" group="2" contype="0" conaffinity="0" />
    </default>
    <default class="collision">
      <geom type="mesh" group="3" />
    </default>
  </default>

  <asset>
    <texture
      name="groundplane"
      type="2d"
      builtin="checker"
      rgb1=".2 .3 .4"
      rgb2=".1 .1 .1"
      width="100"
      height="100"
      mark="cross"
      markrgb=".8 .8 .8"
    />

    <material name="groundplane" texture="groundplane" texrepeat="5 5" texuniform="true" />
    <material name="white" rgba="0.8 0.8 0.8 1" />
    <material name="black" rgba="0.2 0.2 0.2 1" />

    <mesh name="fl_swerve_module" file="frc_python/resources/subsystems/drivetrain/FLSwerveModule.stl" />
    <mesh name="fl_swerve_module_turret" file="frc_python/resources/subsystems/drivetrain/FLSwerveModuleTurret.stl" />
    <mesh name="fl_swerve_module_wheel" file="frc_python/resources/subsystems/drivetrain/FLSwerveModuleWheel.stl" />
    <mesh name="fr_swerve_module" file="frc_python/resources/subsystems/drivetrain/FRSwerveModule.stl" />
    <mesh name="drive_train_frame" file="frc_python/resources/subsystems/drivetrain/DriveTrainFrame.stl" />

    <mesh name="audience_side_field_wall" file="frc_python/resources/AudienceSideFieldWall.stl" />
    <mesh name="scoring_side_field_wall" file="frc_python/resources/ScoringSideFieldWall.stl" />
    <mesh name="red_alliance_driver_station" file="frc_python/resources/RedAllianceDriverStation.stl" />
    <mesh name="blue_alliance_driver_station" file="frc_python/resources/BlueAllianceDriverStation.stl" />
    <mesh name="red_speaker" file="frc_python/resources/RedSpeaker.stl" />
    <mesh name="blue_speaker" file="frc_python/resources/BlueSpeaker.stl" />
    <mesh name="red_source" file="frc_python/resources/RedSource.stl" />
    <mesh name="blue_source" file="frc_python/resources/BlueSource.stl" />
  </asset>

  <worldbody>
    <light pos="1 -1 1.5" dir="-1 1 -1" diffuse="0.5 0.5 0.5" directional="true" />
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="1.5 0.1 0.01" />

    <geom mesh="audience_side_field_wall" class="visual" material="white" />
    <geom mesh="scoring_side_field_wall" class="visual" material="white" />
    <!-- this might be the wrong alliances? -->
    <geom mesh="red_alliance_driver_station" class="visual" material="white" />
    <geom mesh="red_speaker" class="visual" material="white" />
    <geom mesh="red_source" class="visual" material="white" />
    <geom mesh="blue_alliance_driver_station" class="visual" material="white" />
    <geom mesh="blue_speaker" class="visual" material="white" />
    <geom mesh="blue_source" class="visual" material="white" />

    <geom name="audience_side_field_wall_collision" type="box" pos="0 -4.206 0.2615" size="8.268 0.1 0.241" class="collision" material="white" friction="0.3 0.005 0.0001" />
    <geom name="scoring_side_field_wall_collision" type="box" pos="0 4.206 0.2615" size="8.268 0.1 0.241" class="collision" material="white" friction="0.3 0.005 0.0001" />
    <geom name="red_alliance_driver_station_collision_large" type="box" pos="8.2955 1.163 0.9955" size="0.0245 1.84 1.981" class="collision" material="white" friction="0.3 0.005 0.0001" />
    <geom name="red_alliance_driver_station_collision_small" type="box" pos="8.2975 -3.144 0.995" size="0.0225 0.9375 0.99" class="collision" material="white" friction="0.3 0.005 0.0001" />
    <geom name="blue_alliance_driver_station_collision_large" type="box" pos="-8.2955 0.9375 0.9955" size="0.0245 1.84 1.981" class="collision" material="white" friction="0.3 0.005 0.0001" />
    <geom name="blue_alliance_driver_station_collision_small" type="box" pos="-8.2975 -3.144 0.995" size="0.0225 0.9375 0.99" class="collision" material="white" friction="0.3 0.005 0.0001" />

    <body name="drive_train_frame">
      <freejoint name="root" />
      <inertial pos="0 0 0" mass="30" diaginertia="5 5 5" />
      <geom type="box" pos="-0.3302 0 0.06985" size="0.0125 0.235 0.0255" class="collision" material="white" mass="1.5" friction="0.2 0.005 0.0001" />
      <geom type="box" pos="0 -0.3302 0.06985" size="0.235 0.0125 0.0255" class="collision" material="white" mass="1.5" friction="0.2 0.005 0.0001" />
      <geom type="box" pos="0.3302 0 0.06985" size="0.0125 0.235 0.0255" class="collision" material="white" mass="1.5" friction="0.2 0.005 0.0001" />
      <geom type="box" pos="0 0.3302 0.06985" size="0.235 0.0125 0.0255" class="collision" material="white" mass="1.5" friction="0.2 0.005 0.0001" />

      <geom mesh="drive_train_frame" class="visual" material="white" />
      <geom mesh="fl_swerve_module" class="visual" material="white" />
      <geom mesh="fr_swerve_module" class="visual" material="white" />
      <geom mesh="fl_swerve_module" class="visual" material="white" axisangle="0 0 1 3.1416" />
      <geom mesh="fr_swerve_module" class="visual" material="white" axisangle="0 0 1 3.1416" />

      <site name="imu_site" pos="0 0 0" />

      <body name="fl_swerve_module_turret" pos="0.276225 0.276225 0">
        <inertial pos="0 0 0" mass="1.5" diaginertia="0.02 0.02 0.02" />
        <joint name="fl_swerve_module_suspension" type="slide" axis="0 0 1" stiffness="50000" damping="1000" pos="0 0 0" springref="0" />
        <joint name="fl_swerve_module_turret_hinge" type="hinge" axis="0 0 1" pos="0 0 0" armature="0.0015" damping="3.2" />
        <geom mesh="fl_swerve_module_turret" pos="0.066675 0.066675 0" class="visual" material="white" />

        <body name="fl_swerve_module_wheel" pos="0 0 0.0508">
          <inertial pos="0 0 0" mass="0.4" diaginertia="0.001 0.001 0.001" />
          <joint name="fl_swerve_module_wheel_hinge" type="hinge" axis="0 1 0" pos="0 0 0" armature="0.002" damping="0.66" />
          <geom mesh="fl_swerve_module_wheel" pos="0.066675 0.066675 -0.0508" class="visual" material="white" />
          <geom name="fl_swerve_module_wheel_collision" type="sphere" size="0.0508" class="collision" material="black" friction="2.4 0.001 0.01" />
        </body>
      </body>

      <body name="fr_swerve_module_turret" pos="0.276225 -0.276225 0">
        <inertial pos="0 0 0" mass="1.5" diaginertia="0.02 0.02 0.02" />
        <joint
          name="fr_swerve_module_suspension"
          type="slide"
          axis="0 0 1"
          stiffness="50000"
          damping="1000"
          pos="0 0 0"
          springref="0"
        />
        <joint name="fr_swerve_module_turret_hinge" type="hinge" axis="0 0 1" pos="0 0 0" armature="0.0015" damping="0.2" />
        <geom mesh="fl_swerve_module_turret" pos="0.066675 0.066675 0" class="visual" material="white" />

        <body name="fr_swerve_module_wheel" pos="0 0 0.0508">
          <inertial pos="0 0 0" mass="0.4" diaginertia="0.001 0.001 0.001" />
          <joint name="fr_swerve_module_wheel_hinge" type="hinge" axis="0 1 0" pos="0 0 0" armature="0.002" damping="0.66" />
          <geom mesh="fl_swerve_module_wheel" pos="0.066675 0.066675 -0.0508" class="visual" material="white" />
          <geom
            name="fr_swerve_module_wheel_collision"
            type="sphere"
            size="0.0508"
            class="collision"
            material="black"
            friction="2.4 0.001 0.01"
          />
        </body>
      </body>

      <body name="bl_swerve_module_turret" pos="-0.276225 0.276225 0">
        <inertial pos="0 0 0" mass="1.5" diaginertia="0.02 0.02 0.02" />
        <joint
          name="bl_swerve_module_suspension"
          type="slide"
          axis="0 0 1"
          stiffness="50000"
          damping="1000"
          pos="0 0 0"
          springref="0"
        />
        <joint name="bl_swerve_module_turret_hinge" type="hinge" axis="0 0 1" pos="0 0 0" armature="0.0015" damping="0.2" />
        <geom mesh="fl_swerve_module_turret" pos="0.066675 0.066675 0" class="visual" material="white" />

        <body name="bl_swerve_module_wheel" pos="0 0 0.0508">
          <inertial pos="0 0 0" mass="0.4" diaginertia="0.001 0.001 0.001" />
          <joint name="bl_swerve_module_wheel_hinge" type="hinge" axis="0 1 0" pos="0 0 0" armature="0.002" damping="0.66" />
          <geom mesh="fl_swerve_module_wheel" pos="0.066675 0.066675 -0.0508" class="visual" material="white" />
          <geom
            name="bl_swerve_module_wheel_collision"
            type="sphere"
            size="0.0508"
            class="collision"
            material="black"
            friction="2.4 0.001 0.01"
          />
        </body>
      </body>

      <body name="br_swerve_module_turret" pos="-0.276225 -0.276225 0">
        <inertial pos="0 0 0" mass="1.5" diaginertia="0.02 0.02 0.02" />
        <joint
          name="br_swerve_module_suspension"
          type="slide"
          axis="0 0 1"
          stiffness="50000"
          damping="1000"
          pos="0 0 0"
          springref="0"
        />
        <joint name="br_swerve_module_turret_hinge" type="hinge" axis="0 0 1" pos="0 0 0" armature="0.0015" damping="0.2" />
        <geom mesh="fl_swerve_module_turret" pos="0.066675 0.066675 0" class="visual" material="white" />

        <body name="br_swerve_module_wheel" pos="0 0 0.0508">
          <inertial pos="0 0 0" mass="0.4" diaginertia="0.001 0.001 0.001" />
          <joint name="br_swerve_module_wheel_hinge" type="hinge" axis="0 1 0" pos="0 0 0" armature="0.002" damping="0.66" />
          <geom mesh="fl_swerve_module_wheel" pos="0.066675 0.066675 -0.0508" class="visual" material="white" />
          <geom
            name="br_swerve_module_wheel_collision"
            type="sphere"
            size="0.0508"
            class="collision"
            material="black"
            friction="2.4 0.001 0.01"
          />
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="fl_swerve_module_turret_motor" joint="fl_swerve_module_turret_hinge" gear="1" />
    <motor name="fl_swerve_module_wheel_motor" joint="fl_swerve_module_wheel_hinge" gear="1" />
    <motor name="fr_swerve_module_turret_motor" joint="fr_swerve_module_turret_hinge" gear="1" />
    <motor name="fr_swerve_module_wheel_motor" joint="fr_swerve_module_wheel_hinge" gear="1" />
    <motor name="bl_swerve_module_turret_motor" joint="bl_swerve_module_turret_hinge" gear="1" />
    <motor name="bl_swerve_module_wheel_motor" joint="bl_swerve_module_wheel_hinge" gear="1" />
    <motor name="br_swerve_module_turret_motor" joint="br_swerve_module_turret_hinge" gear="1" />
    <motor name="br_swerve_module_wheel_motor" joint="br_swerve_module_wheel_hinge" gear="1" />
  </actuator>

  <sensor>
    <gyro name="chassis_gyro" site="imu_site" />
  </sensor>
</mujoco>
