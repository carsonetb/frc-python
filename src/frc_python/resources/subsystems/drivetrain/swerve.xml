<mujoco model="mk5n_swerve">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.005" integrator="RK4"/>

  <default>
    <default class="visual">
      <geom type="mesh" group="2" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom type="mesh" group="3" mass="0" density="0"/>
    </default>
  </default>

  <asset>
    <texture name="groundplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .1 .1" width="100" height="100" mark="cross" markrgb=".8 .8 .8"/>

    <material name="groundplane" texture="groundplane" texrepeat="5 5" texuniform="true"/>
    <material name="white" rgba="0.8 0.8 0.8 1"/>

    <mesh name="fl_swerve_module" file="frc_python/resources/subsystems/drivetrain/FLSwerveModule.stl"/>
    <mesh name="fl_swerve_module_turret" file="frc_python/resources/subsystems/drivetrain/FLSwerveModuleTurret.stl"/>
    <mesh name="fl_swerve_module_wheel" file="frc_python/resources/subsystems/drivetrain/FLSwerveModuleWheel.stl"/>
    <mesh name="drive_train_frame" file="frc_python/resources/subsystems/drivetrain/DriveTrainFrame.stl"/>
  </asset>

  <worldbody>
    <light pos="1 -1 1.5" dir="-1 1 -1" diffuse="0.5 0.5 0.5" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="drive_train_frame">
      <geom type="box" pos="-0.3302 0 0.06985" size="0.0125 0.235 0.0255" class="collision" material="white"/>
      <geom type="box" pos="0 -0.3302 0.06985" size="0.235 0.0125 0.0255" class="collision" material="white"/>
      <geom type="box" pos="0.3302 0 0.06985" size="0.0125 0.235 0.0255" class="collision" material="white"/>
      <geom type="box" pos="0 0.3302 0.06985" size="0.235 0.0125 0.0255" class="collision" material="white"/>
      <geom mesh="drive_train_frame" class="visual" material="white"/>
      <geom mesh="fl_swerve_module" class="visual" material="white"/>

      <body name="fl_swerve_module_turret" pos="0.276225 -0.276225 0">
        <joint name="fl_swerve_module_turret_hinge" type="hinge" axis="0 0 1" pos="0 0 0" armature="0.05" damping="0.1"/>
        <geom mesh="fl_swerve_module_turret" pos="0.066675 0.066675 0" class="visual" material="white"/>

        <body name="fl_swerve_module_wheel" pos="0 0 0.0508">
          <joint name="fl_swerve_module_wheel_hinge" type="hinge" axis="0 1 0" pos="0 0 0" armature="0.05" damping="0.1"/>
          <geom mesh="fl_swerve_module_wheel" pos="0.066675 0.066675 -0.0508" class="visual" material="white"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="fl_swerve_module_turret_motor" joint="fl_swerve_module_turret_hinge" gear="1"/>
    <motor name="fl_swerve_module_wheel_motor" joint="fl_swerve_module_wheel_hinge" gear="1"/>
  </actuator>
</mujoco>
